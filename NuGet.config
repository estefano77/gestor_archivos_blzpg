<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Fuentes de paquetes de este proyecto.

    Se anula <clear /> a proposito. En la maquina hay un feed de NuGet de la
    empresa (Azure DevOps, FeedNugetSMCSPA) configurado a nivel de usuario, y
    responde 401 Unauthorized sin credenciales. Como NuGet consulta los origenes
    en orden y se detiene en el primero que falla, ese feed rompia el restore
    entero con NU1301, aunque los paquetes que hacen falta esten en nuget.org.

    Anular la lista y declarar aqui solo nuget.org hace que el proyecto se
    restaure igual en el equipo de cualquiera, tenga o no ese feed configurado.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
