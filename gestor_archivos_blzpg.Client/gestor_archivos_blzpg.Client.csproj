<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

    <!--
      Nombre del ensamblado en minusculas, como el repositorio, pero namespace
      del codigo en PascalCase, que es la convencion de C#.
    -->
    <RootNamespace>GestorArchivosBlzpg.Client</RootNamespace>
    <AssemblyName>gestor_archivos_blzpg.Client</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestorArchivosBlzpg.Comun\GestorArchivosBlzpg.Comun.csproj" />
  </ItemGroup>

</Project>
