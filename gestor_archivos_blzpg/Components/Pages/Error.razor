@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics


<div class="pagina-error">
    <h1>Algo ha ido mal</h1>
    <p>Se ha producido un error al procesar la peticion. Se ha registrado en el servidor.</p>

    @if (MostrarId)
    {
        <p>
            Identificador de la peticion: <code>@IdPeticion</code>
        </p>
    }

    <a class="boton boton-primario" href="/">Volver al inicio</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? Contexto { get; set; }

    private string? IdPeticion { get; set; }
    private bool MostrarId => !string.IsNullOrEmpty(IdPeticion);

    protected override void OnInitialized() => IdPeticion = Activity.Current?.Id;
}
